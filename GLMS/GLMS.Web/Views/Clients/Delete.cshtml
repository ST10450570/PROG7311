@model GLMS.Web.Models.Client
@{
    ViewData["Title"] = "Delete Client";
}

<h3 class="text-danger">Delete Client</h3>
<p>Are you sure you want to delete <strong>@Model.Name</strong>? This will also delete all associated contracts.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
