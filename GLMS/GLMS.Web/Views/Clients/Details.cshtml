@model GLMS.Web.Models.Client
@{
    ViewData["Title"] = "Client Details";
}

<h3>@Model.Name</h3>
<hr />
<dl class="row">
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.ContactEmail</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.ContactPhone</dd>
    <dt class="col-sm-3">Region</dt><dd class="col-sm-9">@Model.Region</dd>
</dl>

<h5 class="mt-4">Contracts</h5>
@if (Model.Contracts.Any())
{
    <table class="table table-sm table-bordered">
        <thead class="table-secondary">
            <tr>
                <th>#</th><th>Start</th><th>End</th><th>Status</th><th>Level</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Contracts)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.StartDate.ToShortDateString()</td>
                    <td>@c.EndDate.ToShortDateString()</td>
                    <td>@c.Status</td>
                    <td>@c.ServiceLevel</td>
                    <td><a asp-controller="Contracts" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No contracts yet.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
