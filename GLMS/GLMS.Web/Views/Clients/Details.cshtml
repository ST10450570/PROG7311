@model GLMS.Web.ViewModels.Clients.ClientViewModel

@{
    ViewData["Title"] = "Client Details";
}

<h2>Client Details</h2>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.ContactEmail</dd>
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.ContactPhone</dd>
        <dt class="col-sm-2">Region</dt>
        <dd class="col-sm-10">@Model.Region</dd>
    </dl>
</div>

<h4>Associated Contracts</h4>
@if (Model.Contracts.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Contract ID</th>
                <th>Status</th>
                <th>Service Level</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Contracts)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Status</td>
                    <td>@c.ServiceLevel</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No contracts found for this client.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>