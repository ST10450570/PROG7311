@model GLMS.Web.ViewModels.Contracts.ContractViewModel

@{
    ViewData["Title"] = "Delete Contract";
}

<h2>Delete Contract</h2>
<h3 class="text-danger">Are you sure you want to delete this contract?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Client Name</dt>
        <dd class="col-sm-10">@Model.ClientName</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>