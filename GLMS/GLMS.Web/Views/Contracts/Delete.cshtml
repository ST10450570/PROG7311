@model GLMS.Web.Models.Contract
@{
    ViewData["Title"] = "Delete Contract";
}

<h3 class="text-danger">Delete Contract #@Model.Id</h3>
<p>Are you sure you want to delete the <strong>@Model.ServiceLevel</strong> contract for <strong>@Model.Client?.Name</strong>? All linked service requests will also be removed.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
