@model GLMS.Web.ViewModels.Contracts.ContractViewModel

@{
    ViewData["Title"] = "Contract Details";
}

<h2>Contract Details (#@Model.Id)</h2>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Client</dt>
        <dd class="col-sm-10">@Model.ClientName</dd>
        
        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>
        
        <dt class="col-sm-2">End Date</dt>
        <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            @if (Model.Status == "Active")
            {
                <span class="badge bg-success">@Model.Status</span>
            }
            else if (Model.Status == "Draft")
            {

                <span class="badge bg-secondary">@Model.Status</span>
            }
            else if (Model.Status == "Expired")
            {

                <span class="badge bg-danger">@Model.Status</span>
            }
            else
            {

                <span class="badge bg-warning text-dark">@Model.Status</span>
            }
        </dd>
        
        <dt class="col-sm-2">Service Level</dt>
        <dd class="col-sm-10">@Model.ServiceLevel</dd>

        <dt class="col-sm-2">Agreement</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
            {
                <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary" target="_blank">Download PDF</a>
            }
            else
            {
                <span class="text-muted">No agreement uploaded</span>
            }
        </dd>
    </dl>
</div>

<h4 class="mt-4">Service Requests</h4>
@if (Model.ServiceRequests.Any())
{
    <table class="table table-bordered table-sm mt-2">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Description</th>
                <th>Cost (USD)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sr in Model.ServiceRequests)
            {
                <tr>
                    <td>@sr.Id</td>
                    <td>@sr.Description</td>
                    <td>$@sr.CostUsd.ToString("0.00")</td>
                    <td>@sr.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No service requests linked to this contract.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Update Status</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>