@model GLMS.Web.ViewModels.Contracts.ContractFilterViewModel
@using GLMS.Web.ViewModels

@{
    ViewData["Title"] = "Contracts";
}

<h2>Contracts</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="StartDateFrom" class="form-label">Start Date From</label>
                <input asp-for="StartDateFrom" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="StartDateTo" class="form-label">Start Date To</label>
                <input asp-for="StartDateTo" class="form-control" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Contract</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Client Name</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Service Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ClientName</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>
                <td>
                    @if (item.Status == "Active")
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else if (item.Status == "Draft")
                    {

                        <span class="badge bg-secondary">@item.Status</span>
                    }
                    else if (item.Status == "Expired")
                    {

                        <span class="badge bg-danger">@item.Status</span>
                    }
                    else
                    {

                        <span class="badge bg-warning text-dark">@item.Status</span>
                    }
                </td>
                <td>@item.ServiceLevel</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Status</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>