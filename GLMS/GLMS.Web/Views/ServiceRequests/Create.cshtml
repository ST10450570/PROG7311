@model GLMS.Web.ViewModels.ServiceRequests.CreateServiceRequestViewModel

@{
    ViewData["Title"] = "Create Service Request";
}

<h2>Create Service Request</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="ContractId" class="form-label"></label>
                <select asp-for="ContractId" asp-items="ViewBag.ActiveContracts" class="form-select">
                    <option value="">-- Select Active Contract --</option>
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ExchangeRate" class="form-label"></label>
                <input asp-for="ExchangeRate" class="form-control bg-light" id="ExchangeRate" readonly />
                <small class="text-muted">Live exchange rate fetched from API.</small>
            </div>
            <div class="mb-3">
                <label asp-for="CostUsd" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="CostUsd" class="form-control" id="CostUsd" type="number" step="0.01" />
                </div>
                <span asp-validation-for="CostUsd" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CostZar" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">R</span>
                    <input asp-for="CostZar" class="form-control bg-light" id="CostZar" readonly />
                </div>
                <small class="text-muted">Calculated dynamically.</small>
            </div>
            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const usdInput = document.getElementById("CostUsd");
            const zarOutput = document.getElementById("CostZar");
            const rateInput = document.getElementById("ExchangeRate");

            usdInput.addEventListener("input", function () {
                const usd = parseFloat(usdInput.value) || 0;
                const rate = parseFloat(rateInput.value) || 0;
                zarOutput.value = (usd * rate).toFixed(2);
            });
        });
    </script>
}