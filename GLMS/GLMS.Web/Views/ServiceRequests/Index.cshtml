@model IEnumerable<GLMS.Web.Models.ServiceRequest>
@{
    ViewData["Title"] = "Service Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Service Requests</h3>
    <a asp-action="Create" class="btn btn-warning">+ New Request</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Contract</th>
            <th>Client</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sr in Model)
        {
            <tr>
                <td>@sr.Id</td>
                <td>#@sr.ContractId</td>
                <td>@sr.Contract?.Client?.Name</td>
                <td>@sr.Description</td>
                <td>@sr.CostUsd.ToString("N2")</td>
                <td>@sr.CostZar.ToString("N2")</td>
                <td>@sr.Status</td>
                <td>@sr.CreatedOn.ToShortDateString()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@sr.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@sr.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
