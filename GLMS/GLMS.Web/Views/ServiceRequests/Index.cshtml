@model IEnumerable<GLMS.Web.ViewModels.ServiceRequests.ServiceRequestViewModel>

@{
    ViewData["Title"] = "Service Requests";
}

<h2>Service Requests</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Service Request</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Contract #</th>
            <th>Client</th>
            <th>Description</th>
            <th>Cost (USD)</th>
            <th>Cost (ZAR)</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.ContractId</td>
                <td>@item.ClientName</td>
                <td>@item.Description</td>
                <td>$@item.CostUsd.ToString("0.00")</td>
                <td>R@item.CostZar.ToString("0.00")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>