@model GLMS.Web.ViewModels.ServiceRequests.ServiceRequestViewModel

@{
    ViewData["Title"] = "Delete Service Request";
}

<h2>Delete Service Request</h2>
<h3 class="text-danger">Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Cost (USD)</dt>
        <dd class="col-sm-10">$@Model.CostUsd.ToString("0.00")</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>