@model GLMS.Web.ViewModels.ServiceRequests.ServiceRequestViewModel

@{
    ViewData["Title"] = "Service Request Details";
}

<h2>Service Request Details</h2>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Contract ID</dt>
        <dd class="col-sm-10">@Model.ContractId</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Cost (USD)</dt>
        <dd class="col-sm-10">$@Model.CostUsd.ToString("0.00")</dd>
        <dt class="col-sm-2">Cost (ZAR)</dt>
        <dd class="col-sm-10">R@Model.CostZar.ToString("0.00")</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        <dt class="col-sm-2">Created On</dt>
        <dd class="col-sm-10">@Model.CreatedOn.ToString("g")</dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>