@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h2>Global Logistics Management System</h2>
        <p class="text-muted">TechMove Logistics — Enterprise Contract & Service Request Platform</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Clients</h5>
                <p class="card-text text-muted">Manage client profiles and their associated regions.</p>
                <a asp-controller="Clients" asp-action="Index" class="btn btn-primary">View Clients</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success h-100">
            <div class="card-body">
                <h5 class="card-title">Contracts</h5>
                <p class="card-text text-muted">Create and track contracts — Draft, Active, Expired, On Hold.</p>
                <a asp-controller="Contracts" asp-action="Index" class="btn btn-success">View Contracts</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h5 class="card-title">Service Requests</h5>
                <p class="card-text text-muted">Raise service requests against active contracts with live ZAR conversion.</p>
                <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-warning">View Requests</a>
            </div>
        </div>
    </div>
</div>
